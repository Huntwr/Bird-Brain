<link rel="stylesheet" href="/css/style.css">

<div class="comment-container p-4 mt-4">

  <header class="profile-header d-flex align-items-center gap-3 mb-4">

      <!-- Profile Picture -->
      <div class="pfp-wrapper">
        <img 
            src="{{user.profile_picture}}"
            alt="Profile Picture"
            class="pfp-image"
            id="profile-img"
        >
      </div>
      <div class="user-info">
          <h1 class="username">{{user.name}}</h1>
          <p class="description">Email: {{user.email}}</p>
          <p class="description">Member since: {{user.formatted_date}}</p>
          {{#if user.bio}}
            <p class="description">Bio: {{user.bio}}</p>
          {{else}}
            <p class="description">Bio: Not set yet.</p>
          {{/if}}
      </div>

  </header>

  <button id="editBtn" class="btn btn-primary mb-3">Edit Profile</button>

  <!-- Hidden Edit Form -->
  <form id="editForm" action="/profile/update" method="POST" enctype="multipart/form-data" style="display:none;" class="mb-4">
      <div class="mb-3">
          <label>Profile Picture:</label>
          <input type="file" name="profile_picture" class="form-control">
      </div>

      <div class="mb-3">
          <label>Bio:</label>
          <textarea name="bio" class="form-control" rows="3">{{user.bio}}</textarea>
      </div>

      <button type="submit" class="btn btn-success">Save Changes</button>
  </form>

  <script>
    document.getElementById("editBtn").addEventListener("click", () => {
      const form = document.getElementById("editForm");
      form.style.display = form.style.display === "none" ? "block" : "none";
    });
  </script>

<h2 class="section-title">My Posts</h2>

{{#if posts.length}}
  <div class="posts-container">
    {{#each posts}}
      <div class="post-card">
        <img class="post-photo" src="{{this.photo}}" alt="Bird Photo">

        <div class="post-info">
          <h3>{{this.bird}}</h3>
          <p>{{this.description}}</p>
          <p class="small">Location: {{this.location}}</p>
          <p class="small">Posted: {{this.created_at}}</p>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <p class="no-posts">You haven't logged any birds yet.</p>
{{/if}}


</div>
