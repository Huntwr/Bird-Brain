<div class="comment-container">
  <!-- Post Info -->
  <div class="post-info-container">
    <div class="post-picture">Picture</div>
    <div class="bird-info">
      <p>Bird Name: Blue Jay</p>
      <p>Location: Central Park</p>
      <p>Date: Nov 6, 2025</p>
    </div>
  </div>

  <!-- Comment Section -->
  <div class="comment-section">
    <h3>Comment Here</h3>
    <form class="comment-form">
      <textarea placeholder="Write your comment..."></textarea>
      <button type="submit">Post Comment</button>
    </form>

    <!-- Sample comments -->
    <div class="comment-list">
      <div class="comment">
        <div class="pfp"></div>
        <div class="comment-content">
          <span class="comment-username">User1 writes:</span>
          <p class="comment-text">This is a placeholder comment.</p>
        </div>
      </div>
      <div class="comment">
        <div class="pfp"></div>
        <div class="comment-content">
          <span class="comment-username">User2 writes:</span>
          <p class="comment-text">Another example comment.</p>
        </div>
      </div>
    </div>
  </div>
</div>