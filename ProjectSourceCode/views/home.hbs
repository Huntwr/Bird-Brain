<div id="map"></div>

<!-- Welcome Overlay -->
<div id="welcome-card" class="welcome-overlay">
  <button id="close-welcome" class="close-btn">×</button>
  <h1>Welcome to Bird Brain</h1>
  <p class="subtitle">Track and share your bird sightings with friends!</p>
</div>

<script>
  async function initMap() {
    try {
      const res = await fetch('/config');
      const data = await res.json();
      
      console.log('Mapbox API Key received:', data.mapboxKey ? 'Yes' : 'No');
      console.log('API Key length:', data.mapboxKey?.length);

      mapboxgl.accessToken = data.mapboxKey;
      
      console.log('Creating map...');
      const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/outdoors-v12',
        center: [-105.2705, 40.0150], // Boulder, CO
        zoom: 10
      });
      
      console.log('Map created successfully');

      map.addControl(new mapboxgl.NavigationControl());

      new mapboxgl.Marker()
        .setLngLat([-105.2705, 40.0150])
        .setPopup(new mapboxgl.Popup().setText('CU Boulder - Bird Brain HQ'))
        .addTo(map);
        
      map.on('load', () => {
        console.log('Map loaded successfully');
      });
      
      map.on('error', (e) => {
        console.error('Map error:', e);
      });
    } catch (err) {
      console.error('Error loading map:', err);
    }
  }

  initMap();

  // Close Welcome overlay
  document.addEventListener("DOMContentLoaded", () => {
    const closeBtn = document.getElementById("close-welcome");
    const welcomeCard = document.getElementById("welcome-card");

    closeBtn.addEventListener("click", () => {
      welcomeCard.style.display = "none";
    });
  });
</script>
