<div class="feed-wrapper" style="max-width:1100px; margin: 2rem auto; padding: 0 16px;">

  <!-- Toggle -->
  <div class="post-toggle" style="display:flex; justify-content:center; gap:12px; margin-bottom:20px;">
    <button id="allBtn" class="toggle-btn active">All</button>
    <button id="friendsBtn" class="toggle-btn">Friends</button>
  </div>

  <!-- ALL POSTS -->
  <div id="allSection">
    <h2 class="section-title">All Sightings</h2>
    <div class="card-grid">
      {{#if allLogs.length}}
        {{#each allLogs}}
          <div class="bird-card">
            <img src="{{this.photo}}" class="bird-photo" alt="{{this.species}}" onerror="this.src='/images/default_bird.png'"/>
            <div class="bird-card-body">
              <p class="friend-name">{{this.user}}</p>
              <h3>{{this.species}}</h3>
              <p class="location">{{this.location}}</p>
              <p class="date">{{this.sighting_date}}</p>
              <p class="notes">{{this.notes}}</p>
              <a href="/comments/{{this.id}}" class="comment-link" style="display: inline-block; margin-top: 10px; color: #8d6e63; text-decoration: none; font-weight: 500;">💬 Comment</a>
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="empty-note">No sightings yet. <a href="/log-bird">Log the first one</a>!</div>
      {{/if}}
    </div>
  </div>

  <!-- FRIENDS -->
  <div id="friendsSection" style="display:none;">
    <h2 class="section-title">Friend Sightings</h2>
    <div class="card-grid">
      {{#if friendLogs.length}}
        {{#each friendLogs}}
          <div class="bird-card friend-card">
            <img src="{{this.photo}}" class="bird-photo" alt="{{this.species}}" onerror="this.src='/images/default_bird.png'"/>
            <div class="bird-card-body">
              <p class="friend-name">{{this.user}}</p>
              <h3>{{this.species}}</h3>
              <p class="location">{{this.location}}</p>
              <p class="date">{{this.sighting_date}}</p>
              <p class="notes">{{this.notes}}</p>
              {{#if this.id}}
                <a href="/comments/{{this.id}}" class="comment-link" style="display: inline-block; margin-top: 10px; color: #8d6e63; text-decoration: none; font-weight: 500;">💬 Comment</a>
              {{/if}}
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="empty-note">No friend sightings yet. <a href="/friends">Add some friends</a> to see their bird posts here!</div>
      {{/if}}
    </div>
  </div>

</div>

<style>
/* reuse your theme colors */
.section-title { color: #5d4037; margin: 12px 0; font-weight:600; }
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 22px;
}
.bird-card {
  background: #fffaf5;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 10px 24px rgba(78,52,46,0.14);
  display: flex;
  flex-direction: column;
}
.bird-photo {
  width: 100%;
  height: 190px;
  object-fit: cover;
  display: block;
}
.bird-card-body { padding: 14px 16px; }
.bird-card h3 { margin: 0 0 6px; color:#4e342e; }
.friend-card { border-left: 5px solid #a1887f; }
.friend-name { color:#8d6e63; font-size:0.9rem; margin-bottom:6px; }

/* Toggle buttons */
.toggle-btn {
  padding: 8px 18px;
  border-radius: 24px;
  border: 2px solid #8d6e63;
  background: #fffaf5;
  color: #5d4037;
  font-weight:600;
  cursor:pointer;
}
.toggle-btn.active { background:#8d6e63; color:white; }

/* empty note */
.empty-note { padding: 18px; background:#fff8f0; border-radius:12px; text-align:center; color:#6d4c41; }
</style>

<script>
  const allBtn = document.getElementById('allBtn');
  const friendsBtn = document.getElementById('friendsBtn');
  const allSection = document.getElementById('allSection');
  const friendsSection = document.getElementById('friendsSection');

  allBtn.addEventListener('click', () => {
    allBtn.classList.add('active'); friendsBtn.classList.remove('active');
    allSection.style.display = ''; friendsSection.style.display = 'none';
  });

  friendsBtn.addEventListener('click', () => {
    friendsBtn.classList.add('active'); allBtn.classList.remove('active');
    friendsSection.style.display = ''; allSection.style.display = 'none';
  });
</script>