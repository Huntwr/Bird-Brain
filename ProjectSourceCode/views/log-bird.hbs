
<div class="container py-5" style="max-width:900px; margin: 0 auto;">
  <h1 class="h3 mb-4">Log a Bird Sighting</h1>

  <form class="needs-validation" action="/log-bird" method="POST" enctype="multipart/form-data" novalidate>
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="mb-3">
          <label class="form-label">Bird <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="species" placeholder="e.g., American Robin" required />
          <div class="invalid-feedback">Please enter the bird name.</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Location</label>
          <input type="text" class="form-control" name="location" placeholder="e.g., Chautauqua Park, Boulder, CO" />
        </div>

        <div class="mb-3">
          <label class="form-label">Time</label>
          <input type="datetime-local" class="form-control" name="sighting_date" />
        </div>

        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea class="form-control" name="notes" rows="7" placeholder="Notes about behavior, weather, call, etc."></textarea>
        </div>
      </div>

      <div class="col-lg-6">
        <label class="form-label d-flex justify-content-between align-items-center">
          <span>Upload Picture <span class="text-danger">(required)</span></span>
        </label>

        <div id="uploadZone" class="upload-drop" style="background:#fffaf5; padding:14px; border-radius:12px;">
          <input id="photo" class="upload-input" type="file" name="photo" accept="image/*" required />
          <div id="emptyState" class="upload-empty" style="text-align:center; padding:26px; color:#6d4c41;">
            <div class="display-6"><i class="bi bi-plus-lg"></i></div>
            <div class="mt-2">Click or drag a photo here</div>
            <small class="text-secondary d-block mt-1">PNG/JPG up to ~10MB</small>
          </div>
        </div>
        <div class="invalid-feedback d-block" id="photoInvalid" style="display:none;">Please upload a picture.</div>
      </div>
    </div>

    <hr class="my-4" />
    <div style="display:flex; gap:12px;">
      <button class="btn btn-primary" type="submit">Submit</button>
      <button class="btn btn-outline-secondary" type="reset">Reset</button>
    </div>
  </form>
</div>

<script>
  // Basic client validation visual (optional)
  document.querySelector('form').addEventListener('submit', (e) => {
    const file = document.querySelector('input[type="file"]').files[0];
    const species = document.querySelector('input[name="species"]').value.trim();
    if (!species) {
      e.preventDefault();
      alert('Please enter a bird species.');
      return;
    }
    if (!file) {
      e.preventDefault();
      alert('Please upload a photo.');
      return;
    }
  });
</script>