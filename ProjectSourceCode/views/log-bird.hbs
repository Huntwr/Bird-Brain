<div class="container py-5">

  <h1 class="h3 mb-4">Log a Bird Sighting</h1>

  <form
    class="needs-validation"
    novalidate
    action="/log-bird"
    method="POST"
    enctype="multipart/form-data"
  >

    <div class="row g-4">
      <div class="col-lg-6">

<!-- Species list (CTRL+F enabled) -->
<div class="mb-3">
  <label class="form-label">Choose Species (CTRL+F to search)</label>

  <div id="speciesListBox"
       style="border: 1px solid #ccc; border-radius: 6px; height: 300px; overflow-y: scroll;">
    <div id="speciesList">Loading species...</div>
  </div>

  <small class="text-secondary">
    Tip: Press <strong>CTRL + F</strong> to search the list.
  </small>
  <!-- Selected Bird Display -->
<div class="mt-3 p-3 border rounded bg-light">
  <strong>Selected Bird:</strong>
  <div id="selectedBirdDisplay" class="mt-1 text-primary fw-bold">
    None selected
  </div>
</div>

<!-- Hidden required field -->
<input type="hidden" id="bird" name="bird" required />
</div>

<button type="button" id="identifyBtn" class="btn btn-outline-info btn-sm mt-2">
  I don't know the bird — help identify
</button>
        <!-- Location -->
        <div class="mb-3">
          <label class="form-label">Location</label>
          <input 
            type="text" 
            id="location" 
            name="location"
            class="form-control"
            placeholder="e.g., Chautauqua Park, Boulder, CO"
          />
        </div>

        <input type="hidden" id="latitude" name="latitude" />
        <input type="hidden" id="longitude" name="longitude" />

        <!-- Time -->
        <div class="mb-3">
          <label class="form-label">Time</label>
          <input type="datetime-local" id="time" name="time" class="form-control" />
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea 
            id="description"
            name="description"
            class="form-control"
            rows="7"
            placeholder="Notes about behavior, weather, call, etc."
          ></textarea>
        </div>

      </div>

      <!-- Photo upload -->
      <div class="col-lg-6">
        <label class="form-label">Upload Picture <span class="text-danger">(required)</span></label>

        <div id="uploadZone" class="upload-drop">
          <input 
            id="photo" 
            type="file" 
            name="photo"
            class="upload-input"
            accept="image/*"
            required
          />

          <div id="emptyState" class="upload-empty text-center">
            <div class="display-6"><i class="bi bi-plus-lg"></i></div>
            <p class="mt-2">Click or drag a photo here</p>
          </div>
        </div>

        <div id="photoInvalid" class="invalid-feedback d-block" style="display:none;">
          Please upload a picture.
        </div>
      </div>

    </div>

    <hr class="my-4" />
    <button class="btn btn-primary">Submit</button>
    <button class="btn btn-outline-secondary" type="reset">Reset</button>

  </form>
</div>


<!-- IDENTIFY MODAL -->
<div class="modal fade" id="identifyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">

    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Help identify your bird</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <!-- FILTERS -->
        <div class="row mb-3">

          <div class="col-md-4">
            <label class="form-label">Color</label>
            <select id="colorSelect" class="form-select">
              <option value="">Any</option>
              <option value="red">Red</option>
              <option value="yellow">Yellow</option>
              <option value="blue">Blue</option>
              <option value="black">Black</option>
              <option value="brown">Brown</option>
              <option value="white">White</option>
              <option value="gray">Gray</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Size</label>
            <select id="sizeSelect" class="form-select">
              <option value="">Any</option>
              <option value="small">Small</option>
              <option value="medium">Medium</option>
              <option value="large">Large</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label">Beak Type</label>
            <select id="beakSelect" class="form-select">
              <option value="">Any</option>
              <option value="short">Short</option>
              <option value="long">Long</option>
              <option value="hooked">Hooked</option>
              <option value="thin">Thin</option>
              <option value="conical">Conical</option>
            </select>
          </div>

        </div>

        <button id="surveySubmitBtn" class="btn btn-primary w-100 mb-3">
          Find Matching Birds
        </button>

        <div id="loading" class="text-center" style="display:none;">
          <div class="spinner-border text-primary"></div>
          <p>Searching...</p>
        </div>

        <div id="birdResults" class="list-group"></div>

      </div>
    </div>

  </div>
</div>

<script src="/js/logBird.js"></script>
